# Copy this file to .env.local (which stays untracked) and point it at the release the
# inspector should route against. The manifest URL's parent directory must equal the
# manifest's own `release` field, and the bytes must come from the same Valhalla revision
# the WASM binary was compiled from — the loader rejects a mismatch with
# INCOMPATIBLE_DATASET rather than routing on the wrong graph.
VITE_MANIFEST_URL=https://valhalla-route-id.<account>.workers.dev/datasets/<release>/manifest.json

# Optional: decoded-tile cache budget in MiB for the build (default 384, ceiling 512). Set it to
# compare budgets without editing code — `VITE_MEMORY_BUDGET_MIB=96 pnpm build`. A budget below a
# route's working set does not fail, it makes Valhalla re-read what it evicted.
# VITE_MEMORY_BUDGET_MIB=384
