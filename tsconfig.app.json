{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    // The Node-run build/probe scripts under tools/ import the TypeScript core with an explicit
    // `.ts` extension so `node --experimental-strip-types` resolves them without a bundler. Safe
    // here because this project never emits: `noEmit` is already true.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["vite/client", "@cloudflare/workers-types"]
  },
  "include": ["src", "worker", "tools", "vitest.config.ts"]
}
