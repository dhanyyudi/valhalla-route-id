# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
public/wasm/
.wrangler/
.dev.vars

# Playwright: the acceptance spec is tracked, its reports and traces are not. The spec's own
# output directory lives under the gitignored .superpowers/ tree, so these cover the defaults.
test-results/
playwright-report/
blob-report/

# Vendored package doc copies (build-package.js copies these from the repo root into
# packages/*/; they are generated build output, never edits). These rules do not
# affect the tracked packages/valhalla-server/README.md, which is upstream's own.
packages/*/README.md
packages/*/LICENSE
packages/*/NOTICE.md

# Local data inputs (large, never committed). `fixtures/` and the three public/*.json files are
# written by the data scripts (`scripts/prepare-data.py`, `scripts/create-fixture.py`,
# `scripts/minio.js`), so a `git add -A` after a data run must not pick them up.
build/inputs/
fixtures/
public/datasets/
public/manifest.json
public/region.json
public/minio.json

# Verification-corpus output: regenerated by `node tools/verify/compare.mjs <release>` against
# the release, so it is evidence rather than source. The corpus, its sidecar, the SDK-normalised
# control corpus and the generated report under docs/datasets/ are tracked.
# provenance.json records which corpus each output below answers, so it is regenerated with them.
tools/verify/native.jsonl
tools/verify/native-inspect.json
tools/verify/native-sdk-normalised.jsonl
tools/verify/wasm.jsonl
tools/verify/wasm-deadline-lifted.jsonl
tools/verify/provenance.json
tools/verify/*.stderr

# Editor / OS
.DS_Store
*.log
.vscode/
.idea/

# Env
.env
.env.local

# SDD scratch
.superpowers/

# Internal planning docs live under .superpowers/ (never published)
docs/superpowers/
